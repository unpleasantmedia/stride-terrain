// A terrain's ground colour, as the island's Godot shader (from Terrain3D's) blends it: from the four samples round
// the pixel, each one's base and overlay textures (from its control word) weighted by how near the sample is and how
// far its overlay is blended in, each texture then sharpened against the others by its height (in its albedo's alpha),
// so one shows through another's low places first; tinted, and multiplied by the regions' colour map.
namespace Stride.Terrain
{
    shader TerrainGroundColor : ComputeColor, TerrainMaps, PositionStream4
    {
        override float4 Compute()
        {
            float2 uv = (streams.PositionWS.xz - TerrainOrigin.xz) / VertexSpacing;
            float2 index = floor(uv);
            float2 weight = frac(uv);
            float2 invert = 1.0f - weight;
            float4 weights = float4(invert.x * weight.y, weight.x * weight.y, weight.x * invert.y, invert.x * invert.y);

            int3 at0 = IndexCoord(index + float2(0, 1));
            int3 at1 = IndexCoord(index + float2(1, 1));
            int3 at2 = IndexCoord(index + float2(1, 0));
            int3 at3 = IndexCoord(index + float2(0, 0));
            uint4 control = uint4(ControlOf(at0), ControlOf(at1), ControlOf(at2), ControlOf(at3));

            int4 bases = (int4)((control >> 27u) & 0x1Fu);
            int4 overs = (int4)((control >> 22u) & 0x1Fu);
            float4 overWeights = (float4)((control >> 14u) & 0xFFu) / 255.0f * weights;
            float4 baseWeights = weights - overWeights;

            // Each sample's two textures, with their weights summed over the four samples that use the same one.
            int ids[8] = { bases.x, overs.x, bases.y, overs.y, bases.z, overs.z, bases.w, overs.w };
            float total[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
            [unroll]
            for (int i = 0; i < 4; i++)
            {
                int b = (int)bases[i];
                int o = (int)overs[i];
                [unroll]
                for (int k = 0; k < 8; k++)
                {
                    total[k] += (ids[k] == b ? baseWeights[i] : 0.0f) + (ids[k] == o ? overWeights[i] : 0.0f);
                }
            }

            float sharpness = 56.0f * BlendSharpness + 8.0f;
            float3 world = streams.PositionWS.xyz - TerrainOrigin;
            float4 albedo = 0;
            float sum = 0;
            uint read = 0u;
            [unroll]
            for (int t = 0; t < 8; t++)
            {
                uint mask = 1u << (uint)ids[t];
                if ((read & mask) == 0u)
                {
                    read |= mask;
                    float scale = UvScale(ids[t]) * 0.5f;
                    float4 texel = AlbedoMaps.Sample(Texturing.LinearRepeatSampler, float3(world.xz * scale + 0.5f, ids[t]));
                    texel.rgb *= TextureTints[ids[t]].rgb;
                    float w = exp2(sharpness * log2(max(total[t] + texel.a, 1e-5f)));
                    albedo += texel * w;
                    sum += w;
                }
            }
            albedo /= max(sum, 1e-5f);

            // The regions' colour map, a tint over the textures (white for none).
            float4 tint = float4(1, 1, 1, 1);
            int3 here = IndexCoord(uv);
            if (here.z >= 0)
                tint = ColorMaps.SampleLevel(Texturing.LinearSampler, float3((uv - floor(uv / RegionSize) * RegionSize) / RegionSize, here.z), 0);

            return float4(albedo.rgb * tint.rgb, 1.0f);
        }
    };
}
