<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFrameworks>$(StrideRuntimeTargetFrameworks)</TargetFrameworks>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StridePackAssets>true</StridePackAssets>
    <!-- The terrain component is written in scene assets -->
    <StrideContainsAssetTypes>true</StrideContainsAssetTypes>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Companion package: the terrain brushes in .Editor (no asset types, so no .Assets) -->
    <StrideCompanionProject Include="..\Stride.Terrain.Editor\Stride.Terrain.Editor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\engine\Stride.Engine\Stride.Engine.csproj" />
    <ProjectReference Include="..\..\..\engine\Stride.Games\Stride.Games.csproj" />
    <ProjectReference Include="..\..\..\engine\Stride.Rendering\Stride.Rendering.csproj" />
    <!-- Terrain collision is Bullet static mesh colliders -->
    <ProjectReference Include="..\..\BulletPhysics\Stride.Physics\Stride.Physics.csproj" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk/Sdk/Sdk.targets" />
</Project>
